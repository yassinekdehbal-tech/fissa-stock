{
  "appId": "com.fissa.pieceauto",
  "appName": "FISSA PIECE AUTO",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "backgroundColor": "#0d1117",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d1117"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  },
  "ios": {
    "scheme": "FISSA",
    "backgroundColor": "#0d1117",
    "contentInset": "automatic"
  }
}
