---
import Base from '../layouts/Base.astro'
---
<Base title="Page introuvable" noindex>
  <div class="container-x py-24 text-center">
    <p class="text-brand-dark font-black text-6xl">404</p>
    <h1 class="text-2xl font-extrabold text-navy mt-2">Cette page n'existe pas</h1>
    <p class="text-gray-500 mt-2">Le lien est peut-être ancien ou la pièce a été vendue.</p>
    <div class="mt-6 flex justify-center gap-3"><a href="/" class="btn btn-outline">Accueil</a><a href="/pieces" class="btn btn-brand">Voir les pièces</a></div>
  </div>
</Base>
