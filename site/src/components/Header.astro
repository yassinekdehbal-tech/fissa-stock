---
import { SITE } from '../config'
const path = Astro.url.pathname
const nav = [
  { href: '/pieces', label: 'Pièces auto' },
  { href: '/autos', label: 'Véhicules' },
  { href: '/garage', label: 'Mécanique' },
]
const isActive = (href: string) => path === href || path.startsWith(href + '/')
---
<header class="bg-navy text-white sticky top-0 z-40 border-b border-white/10">
  <div class="container-x h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="FISSA GROUPE, accueil">
      <span class="w-9 h-9 rounded-xl bg-brand text-navy font-black text-xl grid place-items-center">F</span>
      <span class="font-extrabold tracking-tight text-lg leading-none">FISSA <span class="text-brand">GROUPE</span></span>
    </a>
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Activités">
      {nav.map((n) => (
        <a href={n.href} class:list={['px-3 py-2 rounded-lg hover:bg-white/10 transition-colors', isActive(n.href) && 'bg-white/10 text-brand']}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href="/garage#devis" class="btn btn-brand !py-2 !px-4 hidden sm:inline-flex">Devis gratuit</a>
      <a href={SITE.stockUrl} rel="nofollow" class="btn btn-outline !py-2 !px-3 !text-white !border-white/30 hover:!border-brand hover:!text-brand" title="Accès réservé aux collaborateurs (FISSA STOCK)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="hidden sm:inline">Connexion</span>
      </a>
    </div>
  </div>
  <nav class="md:hidden border-t border-white/10 text-xs font-medium" aria-label="Activités (mobile)">
    <div class="container-x flex">
      {nav.map((n) => (
        <a href={n.href} class:list={['flex-1 text-center py-2.5 border-b-2 transition-colors', isActive(n.href) ? 'border-brand text-brand' : 'border-transparent text-white/80']}>{n.label}</a>
      ))}
    </div>
  </nav>
</header>
