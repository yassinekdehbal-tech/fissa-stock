---
import { piecePath, formatPrice, conditionLabel, type PublicPiece } from '../lib/pieces'
interface Props { piece: PublicPiece }
const { piece: p } = Astro.props
---
<a href={piecePath(p)} class="card overflow-hidden hover:border-brand transition-colors group flex flex-col">
  <div class="aspect-square bg-gray-50 overflow-hidden grid place-items-center">
    {p.photo
      ? <img src={p.photo} alt={`${p.name}${p.vehicle ? ' ' + p.vehicle : ''}`} loading="lazy" decoding="async" width="400" height="400" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
      : <span class="text-5xl opacity-20" aria-hidden="true">⚙️</span>}
  </div>
  <div class="p-3 flex-1 flex flex-col">
    <div class="flex items-center gap-1.5 mb-1">
      <span class="badge-ref truncate">{p.ref}</span>
      <span class="text-[10px] text-gray-500 truncate">{conditionLabel(p.condition)}{p.etat ? ` · ${p.etat}` : ''}</span>
    </div>
    <div class="text-gray-900 text-sm font-semibold leading-snug line-clamp-2">{p.name}</div>
    {p.vehicle && <div class="text-gray-500 text-xs mt-0.5 truncate">{p.vehicle}</div>}
    <div class="text-navy text-base font-extrabold mt-auto pt-2">{formatPrice(p.price)}</div>
  </div>
</a>
